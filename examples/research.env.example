# Fill only the retrieval keys you want to use. No separate LLM key.
# This is an example; private installed config is research.env.
RESEARCH_SEARCH_PROVIDER=auto
RESEARCH_STRATEGY=balanced
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
LINKUP_API_KEY=
PARALLEL_API_KEY=
SERPSEARCH_API_KEY=
KEENABLE_API_KEY=
ANYSEARCH_API_KEY=
SERPAPI_API_KEY=
RESEARCH_PROVIDER_ORDER=
RESEARCH_DISABLED_PROVIDERS=
RESEARCH_MAX_ATTEMPTS=3
# Blank uses research=60 / quick=12; an explicit value overrides both.
RESEARCH_MAX_API_REQUESTS=
RESEARCH_CACHE_TTL=3600
# Only exact true opts into documented public Keenable endpoints.
RESEARCH_ALLOW_KEYLESS_KEENABLE=false
